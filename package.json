{
  "name": "playground-preview-action",
  "version": "0.0.0",
  "private": true,
  "description": "GitHub Action that posts a WordPress Playground preview button.",
  "license": "GPL-2.0-or-later",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/index.js -o dist",
    "test": "npm run test:unit && npm run test:workflows",
    "test:unit": "jest",
    "test:workflows": "node scripts/test-preview-workflows.mjs"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.0"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.38.1",
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 90,
        "functions": 90,
        "lines": 90,
        "statements": 90
      }
    }
  }
}
